{
  "name": "furnishes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @furnishes/web dev",
    "build": "pnpm --filter @furnishes/web build",
    "start": "pnpm --filter @furnishes/web start",
    "check": "pnpm -r typecheck && pnpm -r lint && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
